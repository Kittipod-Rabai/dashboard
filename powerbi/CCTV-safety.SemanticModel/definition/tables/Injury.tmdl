	/// คลาสของโมเดล CCTV ที่เกี่ยวข้อง (helmet, vest, fall, fire, smoke)
	column related_ai_class
		dataType: string
		lineageTag: 6e1102ee-b18b-46cd-a6eb-e97e0b120c2b
		summarizeBy: none
		sourceColumn: related_ai_class

	/// ชื่อสั้นสำหรับ legend กราฟเส้นโซน E
	column item_short =
			SWITCH (
				Injury[item_th],
				"อาชีพงานพื้นฐาน", "งานพื้นฐาน",
				"ผู้ปฏิบัติงานในโรงงาน/ควบคุมเครื่องจักร/ประกอบ", "คุมเครื่องจักร/ประกอบ",
				"ผู้ปฏิบัติงานโดยใช้ฝีมือ", "ใช้ฝีมือ",
				"วัตถุหรือสิ่งของตัด/บาด/ทิ่มแทง", "ของมีคมตัด/บาด/ทิ่มแทง",
				"วัตถุหรือสิ่งของพังทลาย/หล่นทับ", "ของพังทลาย/หล่นทับ",
				"วัตถุหรือสิ่งของกระแทก/ชน", "ของกระแทก/ชน",
				"วัตถุ สิ่งของ หรือสารเคมีกระเด็นเข้าตา", "ของ/สารเคมีกระเด็นเข้าตา",
				"วัตถุหรือสิ่งของหนีบ/ดึง", "ของหนีบ/ดึง",
				"ก่อสร้างอาคารที่พักอาศัย", "ก่อสร้างที่พักอาศัย",
				"ก่อสร้างอาคารที่ไม่ใช่ที่พักอาศัย", "ก่อสร้างอาคารอื่น",
				"โรคระบบกล้ามเนื้อและโครงสร้างกระดูก", "กล้ามเนื้อ/กระดูก",
				"โรคจากสาเหตุทางชีวภาพ", "สาเหตุทางชีวภาพ",
				"โรคผิวหนังจากสาเหตุทางกายภาพ เคมี หรือชีวภาพ", "ผิวหนัง (กายภาพ/เคมี/ชีวภาพ)",
				"โรคผิวหนังอื่น", "ผิวหนังอื่น",
				"โรคระบบหายใจอื่น", "ระบบหายใจอื่น",
				Injury[item_th]
			)
		dataType: string
		lineageTag: f31c5599-ddf1-4fc2-8b40-13939b46e5e3
		summarizeBy: none

	partition Injury = m
		mode: import
		source =
				let
					Files = Folder.Files(DataFolder),
					CsvFiles = Table.SelectRows(Files, each Text.StartsWith([Name], "sso_injury_") and Text.Lower([Extension]) = ".csv"),
					Parsed = Table.AddColumn(CsvFiles, "Data", each Table.PromoteHeaders(Csv.Document([Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])),
					Combined = Table.Combine(Parsed[Data]),
					Typed = Table.TransformColumnTypes(Combined, {
						{"year_ce", Int64.Type}, {"year_be", Int64.Type}, {"rank_in_year", Int64.Type},
						{"injured_count", Int64.Type}, {"total_injured_year", Int64.Type}, {"insured_employees", Int64.Type},
						{"pct_of_year_total", type number}, {"rate_per_1000_employees", type number},
						{"dimension", type text}, {"dimension_th", type text}, {"dimension_en", type text},
						{"item_th", type text}, {"item_en", type text}, {"related_ai_class", type text}
					}, "en-US")
				in
					Typed

